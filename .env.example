OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Per-request HTTP timeout to OpenRouter (seconds). Requests are not retried automatically.
OPENROUTER_REQUEST_TIMEOUT_SECONDS=30
# Total FastAPI analysis deadline (seconds); keep this above the upstream timeout.
ANALYSIS_REQUEST_TIMEOUT_SECONDS=100
# Optional, comma-separated exact frontend origins when hosting frontend separately.
# Leave empty for the default same-origin Docker deployment.
CORS_ORIGINS=
