# Optional frontend build setting for split frontend/backend hosting only.
# Never place OPENROUTER_API_KEY or any backend secret in a VITE_ variable.
# VITE_API_BASE_URL=https://api.example.com

# Optional Vite development proxy destination; defaults to http://127.0.0.1:8000.
# API_PROXY_TARGET=http://127.0.0.1:8000

# Browser-side safety deadline; should be slightly longer than the backend analysis deadline.
# VITE_ANALYSIS_REQUEST_TIMEOUT_MS=105000
